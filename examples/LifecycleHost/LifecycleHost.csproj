<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hoard.Hosting" Version="[0.1.0]" />
    <PackageReference Include="Hoard.Fixtures.Lifecycle.Protocol.One" Version="[0.1.0]" />
    <PackageReference Include="Hoard.Fixtures.Lifecycle.Protocol.Two" Version="[0.1.0]" />
    <PackageReference Include="Hoard.Fixtures.Lifecycle.Metadata" Version="[0.1.0]" />
    <PackageReference Include="Hoard.Fixtures.Lifecycle.Artifact.One" Version="[0.1.0]" />
    <PackageReference Include="Hoard.Fixtures.Lifecycle.Identity" Version="[0.1.0]" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="[10.0.13]" />
    <Compile Include="Program.cs" />
    <Compile Include="ConfigurationJourneys.cs" />
    <Compile Include="Adapters/MetadataModule.cs" />
    <Compile Include="Adapters/ArtifactOneModule.cs" />
  </ItemGroup>
</Project>
