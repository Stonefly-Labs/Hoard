<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="all" />
    <PackageReference Include="xunit" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" PrivateAssets="all" />
    <Compile Include="../../FoundationEvidence.cs" Link="FoundationEvidence.cs" />
    <Compile Include="../../unit/Hoard.Foundation.Tests/ContractChangeExamples.cs" Link="Conformance/ContractChangeExamples.cs" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup Condition="'$(ConformancePackageAcceptance)' != 'true'">
    <Compile Include="../../fixtures/conformance/Host/CompositionFixtures.cs" Link="Conformance/CompositionFixtures.cs" />
    <Compile Include="../../fixtures/conformance/Host/OwnershipFixtures.cs" Link="Conformance/OwnershipFixtures.cs" />
    <Compile Include="../../fixtures/conformance/Host/VersionFixtures.cs" Link="Conformance/VersionFixtures.cs" />
    <ProjectReference Include="../../../src/Hoard.Hosting/Hoard.Hosting.csproj" />
    <ProjectReference Include="../../../src/Hoard.Application/Hoard.Application.csproj" />
    <ProjectReference Include="../../fixtures/discovery/ReferenceConsumer/ReferenceConsumer.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ConformancePackageAcceptance)' == 'true'">
    <DefineConstants>$(DefineConstants);CONFORMANCE_PROVIDER_PACKAGES</DefineConstants>
    <NuGetLockFilePath>PackageAcceptance/packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup Condition="'$(ConformancePackageAcceptance)' == 'true'">
    <Compile Remove="*.cs" />
    <Compile Include="ConformanceMatrixTests.cs;ConformanceVersionTests.cs;LifecycleFixtures.cs;LifecycleTestHarness.cs;LifecycleTestTimeProvider.cs" />
    <PackageVersion Include="Hoard.Hosting" Version="[0.1.0]" />
    <PackageVersion Include="Hoard.Fixtures.Conformance.Host" Version="[0.1.0]" />
    <PackageVersion Include="Hoard.Fixtures.Metadata.HostAdapters" Version="[0.1.0]" />
    <PackageVersion Include="Hoard.Fixtures.Artifacts.HostAdapters" Version="[0.1.0]" />
    <PackageReference Include="Hoard.Hosting" />
    <PackageReference Include="Hoard.Fixtures.Conformance.Host" />
    <PackageReference Include="Hoard.Fixtures.Metadata.HostAdapters" />
    <PackageReference Include="Hoard.Fixtures.Artifacts.HostAdapters" />
  </ItemGroup>
</Project>
