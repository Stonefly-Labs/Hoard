<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Hoard.Fixtures.Conformance.Consumer</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(ConformanceContributorCategory)' == 'metadata'">$(DefineConstants);HOARD_METADATA_CONTRIBUTOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="SqliteEnvironmentProbe.cs;SqliteNativeOwnershipProbe.cs" />
    <Compile Include="../../../contracts/Hoard.Conformance.Tests/AuthorityIntegrationTests.cs" Link="AuthorityIntegrationTests.cs" />
    <Compile Include="../../../contracts/Hoard.Conformance.Tests/ContributorJourneyTests.cs" Link="ContributorJourneyTests.cs" />
    <Compile Include="../../../contracts/Hoard.Conformance.Tests/CategoryMutationTests.cs" Link="CategoryMutationTests.cs"
             Condition="'$(ConformanceCategoryMutations)' == 'true'" />
    <Compile Include="../Bindings/Mutations/*.cs" Link="Mutations/%(Filename)%(Extension)"
             Condition="'$(ConformanceCategoryMutations)' == 'true'" />
    <PackageReference Include="Hoard.Testing.Conformance" />
    <PackageReference Include="Hoard.Fixtures.Artifacts.HostAdapters" />
    <PackageReference Include="Hoard.Fixtures.Conformance.Bindings.Sqlite" />
    <PackageReference Include="Hoard.Fixtures.Conformance.Bindings.Memory" />
    <PackageReference Include="Hoard.Fixtures.Conformance.Bindings.Local" />
    <PackageReference Include="Hoard.Fixtures.Conformance.Bindings.ObjectSemantics" />
    <PackageReference Include="Hoard.Fixtures.Conformance.Contributor" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup Condition="'$(ConformanceContributorCategory)' == 'metadata' And '$(ConformanceContributorFactory)' != '' And '$(ConformanceContributorPackageId)' != '' And '$(ConformanceContributorPackageVersion)' != ''">
    <Compile Include="$(ConformanceContributorFactory)" Link="ContributorBindingFactory.cs" />
    <PackageReference Remove="$(ConformanceContributorPackageId)" />
    <PackageReference Include="$(ConformanceContributorPackageId)" VersionOverride="[$(ConformanceContributorPackageVersion)]" />
  </ItemGroup>
  <Target Name="ValidateContributorInputs" BeforeTargets="CollectPackageReferences;CoreCompile"
          Condition="'$(ConformanceContributorCategory)' != '' Or '$(ConformanceContributorFactory)' != '' Or '$(ConformanceContributorPackageId)' != '' Or '$(ConformanceContributorPackageVersion)' != ''">
    <Error Condition="'$(ConformanceContributorCategory)' != 'metadata'"
           Text="BindingInvalid" />
    <Error Condition="'$(ConformanceContributorFactory)' == '' Or !Exists('$(ConformanceContributorFactory)') Or '$(ConformanceContributorPackageId)' == '' Or '$(ConformanceContributorPackageVersion)' == ''"
           Text="BindingInvalid" />
  </Target>
</Project>
